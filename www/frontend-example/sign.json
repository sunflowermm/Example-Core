{
  "id": "example",
  "name": "Example-Core 前端（Vite SPA）",
  "description": "动态前端规范示例：默认静态托管 dist/；HMR 时改 serve=proxy 且 enabled=true。",
  "enabled": false,
  "serve": "static",
  "staticRoot": "dist",
  "mode": "dev",
  "command": "pnpm",
  "args": ["dev"],
  "devOnly": true,
  "modes": ["dev"],
  "port": 4173,
  "proxy": { "mount": "/example" },
  "env": { "BROWSER": "none" },
  "autoRestart": true
}
