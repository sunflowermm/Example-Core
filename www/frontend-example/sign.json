{
  "id": "example",
  "name": "Example-Core 前端（Vite SPA）",
  "description": "enabled=false：只 build 挂 dist；enabled=true：启进程反代。",
  "enabled": false,
  "serve": "static",
  "staticRoot": "dist",
  "build": { "command": "pnpm", "args": ["build"] },
  "command": "pnpm",
  "args": ["dev"],
  "port": 4173,
  "proxy": { "mount": "/example" },
  "env": { "BROWSER": "none" },
  "autoRestart": true
}
